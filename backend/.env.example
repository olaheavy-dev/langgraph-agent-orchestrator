# The orchestrator needs one key; every agent shares it.
OPENAI_API_KEY=sk-...

# Optional overrides -- these are the defaults.
# ORCHESTRATOR_MODEL=openai:gpt-4.1-mini
# ORCHESTRATOR_EMBEDDING_MODEL=openai:text-embedding-3-small
# ORCHESTRATOR_CHECKPOINT_PATH=./data/checkpoints.sqlite
# 'structured' (one model call) or 'claude_code' (delegates to the CLI in a
# disposable copy of the workspace). Neither writes without human approval.
# ORCHESTRATOR_CODE_AGENT=structured
# ORCHESTRATOR_CORS_ORIGINS=["http://localhost:3000"]
